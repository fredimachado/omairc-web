---
interface Props { landing?: boolean }
const { landing = false } = Astro.props;
const section = (id: string) => landing ? `#${id}` : `/#${id}`;
---

<header class="site-header" data-site-header>
  <nav class="site-nav wrap" aria-label="Primary">
    <a href={landing ? '#top' : '/'} class="logo">
      <img src="/omairc.svg" alt="" width="26" height="26" />
      Omairc
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span class="sr-only">Menu</span>
      <span aria-hidden="true">☰</span>
    </button>
    <div class="nav-links" id="site-nav">
      <a href={section('agents')}>Agents</a>
      <a href={section('features')}>Features</a>
      <a href={section('install')}>Install</a>
      <a href={section('feedback')}>Feedback</a>
      <a href="/changelog/">Changelog</a>
      <a href="/docs/">Docs</a>
      <a class="search-link" href="/docs/" aria-label="Search documentation">
        <span>Search docs</span><kbd>/</kbd>
      </a>
      <a class="github-link" href="https://github.com/fredimachado/omairc" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C16.3 4.7 17.3 5 17.3 5c.6 1.6.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3z" /></svg>
        GitHub
      </a>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  const toggle = document.querySelector('[data-nav-toggle]');
  const close = () => {
    header?.classList.remove('nav-open');
    toggle?.setAttribute('aria-expanded', 'false');
  };
  toggle?.addEventListener('click', () => {
    const open = !header?.classList.contains('nav-open');
    header?.classList.toggle('nav-open', open);
    toggle.setAttribute('aria-expanded', String(open));
  });
  document.querySelectorAll('#site-nav a').forEach((link) => link.addEventListener('click', close));
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') close(); });
</script>
